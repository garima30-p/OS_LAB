#include <stdio.h>

int main(void)
{
    int n;
    int pid[20], bt[20], priority[20];
    int wt[20], tat[20];
    float totalWT = 0, totalTAT = 0;

    printf("Enter number of processes: ");

    if (scanf("%d", &n) != 1 || n < 1 || n > 20)
    {
        printf("Enter a number between 1 and 20.\n");
        return 1;
    }

    // Input process details.
    for (int i = 0; i < n; i++)
    {
        pid[i] = i + 1;

        printf("P%d burst time: ", pid[i]);

        if (scanf("%d", &bt[i]) != 1 || bt[i] <= 0)
        {
            printf("Burst time must be a positive integer.\n");
            return 1;
        }

        printf("P%d priority: ", pid[i]);

        if (scanf("%d", &priority[i]) != 1)
        {
            printf("Enter an integer priority.\n");
            return 1;
        }
    }

    // Sort by priority; break ties using input order.
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (priority[i] > priority[j] ||
                (priority[i] == priority[j] && pid[i] > pid[j]))
            {
                int temp = priority[i];
                priority[i] = priority[j];
                priority[j] = temp;

                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;

                temp = pid[i];
                pid[i] = pid[j];
                pid[j] = temp;
            }
        }
    }

    wt[0] = 0;

    for (int i = 1; i < n; i++)
    {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    for (int i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];

        totalWT += wt[i];
        totalTAT += tat[i];
    }

    printf("\nPID\tPriority\tBT\tWT\tTAT\n");

    for (int i = 0; i < n; i++)
    {
        printf("P%d\t%d\t\t%d\t%d\t%d\n",
               pid[i], priority[i], bt[i], wt[i], tat[i]);
    }

    printf("\nAverage Waiting Time: %.2f\n", totalWT / n);
    printf("Average Turnaround Time: %.2f\n", totalTAT / n);

    return 0;
}